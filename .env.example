# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: URL to your Supabase project instance (e.g., https://xxx.supabase.co)
SUPABASE_URL=YOUR_SUPABASE_URL_HERE

# SUPABASE_ANON_KEY: Anonymous public key for querying Supabase APIs
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# IMAGEKIT_PUBLIC_KEY: Public key for ImageKit dashboard image upload integration
IMAGEKIT_PUBLIC_KEY=YOUR_IMAGEKIT_PUBLIC_KEY_HERE

# IMAGEKIT_PRIVATE_KEY: Private key for backend/safe signed operations with ImageKit
IMAGEKIT_PRIVATE_KEY=YOUR_IMAGEKIT_PRIVATE_KEY_HERE
