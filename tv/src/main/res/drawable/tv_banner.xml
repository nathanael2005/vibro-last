<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Deep Cinematic Background -->
    <path
        android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180"
                android:type="linear">
                <item android:color="#FF0B132B" android:offset="0.0"/>
                <item android:color="#FF1C2541" android:offset="0.5"/>
                <item android:color="#FF080C1A" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Gold Frame -->
    <path
        android:pathData="M10,10h300v160h-300z"
        android:strokeWidth="2"
        android:strokeColor="#80FFC107"/>

    <!-- Ambient Gold Glow Center -->
    <path
        android:pathData="M160,90m-60,0a60,60 0,1 1,120 0a60,60 0,1 1,-120 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="160"
                android:centerY="90"
                android:gradientRadius="60"
                android:type="radial">
                <item android:color="#33FFC107" android:offset="0.0"/>
                <item android:color="#00000000" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Emblem Badge -->
    <path
        android:pathData="M136,46h48a12,12 0 0 1 12,12v48a12,12 0 0 1 -12,12h-48a12,12 0 0 1 -12,-12v-48a12,12 0 0 1 12,-12z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="124"
                android:startY="46"
                android:endX="196"
                android:endY="118"
                android:type="linear">
                <item android:color="#FFFFD54F" android:offset="0.0"/>
                <item android:color="#FFFFC107" android:offset="0.5"/>
                <item android:color="#FFFFA000" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- N Glyph in Banner Badge -->
    <path
        android:pathData="M144,104V60h10l12,28V60h8v44h-10l-12,-28v28z"
        android:fillColor="#FF0D1B2A"/>

    <!-- Accent Dots / Play Triangle -->
    <path
        android:pathData="M208,82l10,6l-10,6z"
        android:fillColor="#FFFFC107"/>
    <path
        android:pathData="M102,82l10,6l-10,6z"
        android:fillColor="#FFFFC107"/>

</vector>
